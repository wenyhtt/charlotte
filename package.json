{
  "name": "charlotte",
  "version": "1.0.0",
  "description": "Discord bot that lets users rent lightweight Linux containers across multiple VPS nodes, powered by Incus, with browser-based terminal access.",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "oxlint src/ && tsc",
    "start": "node dist/app.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "contract:emit": "prisma contract emit"
  },
  "keywords": [
    "discord",
    "bot",
    "container",
    "linux",
    "incus"
  ],
  "author": "wenyhtt",
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@discordx/importer": "^1.3.3",
    "@prisma/orm-sqlite": "8.0.0-rc.13",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "dotenv": "^18.0.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.2",
    "@types/node": "^26.6.3",
    "oxlint": "^1.86.0",
    "prisma": "8.0.0-rc.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
